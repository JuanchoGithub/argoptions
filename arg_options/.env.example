# Copiar a .env (no commitear .env)
PPI_API_KEY=
PPI_API_SECRET=
PPI_ACCOUNT_NUMBER=
# true = sandbox de PPI
PPI_SANDBOX=true

# Seguridad órdenes reales
ALLOW_LIVE_ORDERS=false
DAILY_ORDER_NOTIONAL_CAP_ARS=500000
MAX_CONTRACTS_PER_ORDER=5

# Alertas (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
